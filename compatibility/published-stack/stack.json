{
  "format": "compute.distribution-profile@1",
  "profile": "configured",
  "name": "published-compute-ecosystem",
  "compute": "0.1.22",
  "platform": "linux-x86_64",
  "distribution": {
    "identity": "compute-configured-0.1.22-linux-x86_64",
    "certification_status": "certified",
    "base_asset": "compute-0.1.22-linux-x86_64.tar.gz",
    "configured_asset": "compute-configured-0.1.22-linux-x86_64.tar.gz",
    "pipeline": "distribution-certification",
    "release": "https://github.com/rkendel1/compute/releases/tag/v0.1.22"
  },
  "runtime": {
    "implementation": "base-compute",
    "shared_binary": true,
    "shared_cli": true,
    "shared_ui": true
  },
  "agent": {
    "default": "stack-agent",
    "runtimes": [
      {
        "name": "stack-agent",
        "package": "github:rkendel1/stack-agent",
        "version": "e73e74a72b42a40ff20ceef02805c99c6ef83d9e",
        "executable": "stack-agent/bin/compute-stack-agent",
        "default": true,
        "capabilities": [
          "Agent/loop@1"
        ],
        "lifecycle": "service",
        "health": {
          "kind": "invocation",
          "command": [],
          "expect": "usage: compute-stack-agent"
        },
        "environment": "compute.session",
        "capability_execution": {
          "where": "compute-session",
          "worker": "capability-exec",
          "one_session_per_work": true,
          "project_source": "COMPUTE_STACK_AGENT_PROJECT",
          "target": "COMPUTE_STACK_AGENT_TARGET",
          "network": "COMPUTE_STACK_AGENT_NETWORK"
        },
        "model_provider": {
          "implementation": "fx (in-process, Rust)",
          "configuration": {
            "provider": "CHIP_PROVIDER",
            "model": "CHIP_MODEL",
            "endpoint": "CHIP_ENDPOINT",
            "api_key": "CHIP_API_KEY"
          },
          "credentials": "agent-process-only"
        },
        "http": {
          "command": [
            "serve"
          ],
          "routes": [
            "POST /v1/work",
            "GET /v1/work/{id}",
            "GET /v1/work/{id}/events",
            "POST /v1/work/{id}/cancel",
            "GET /v1/metrics",
            "GET /health"
          ],
          "auth": "loopback-only"
        },
        "state": "FeltDB file under the agent's runtime data directory (--state-db)"
      }
    ]
  },
  "state": {
    "owner": "compute",
    "root": "COMPUTE_HOME",
    "model": "compute-state",
    "authoritative_durable_backend": "compute-state-file",
    "shared_with_base": true,
    "additional_stores": [],
    "optional_durable_backends": [
      "compute-state-feltdb"
    ]
  },
  "configuration": {
    "stack_path": "stacks/configured/stack.toml",
    "activation": "COMPUTE_STACKS",
    "idempotent": true
  },
  "managed_services": [
    {
      "name": "appport-services",
      "executable": "node_modules/.bin/appport-services",
      "arguments": [
        "serve",
        "--host",
        "127.0.0.1",
        "--port",
        "4100"
      ],
      "endpoint": "http://127.0.0.1:4100",
      "readiness_path": "/v1/ui",
      "capabilities": [
        "AppPort/ui/1"
      ],
      "provider": "this-machine",
      "description": "AppPort Services management UI; owns its own state, authentication and management router. Management needs an AuthBoundry authorizer module (APPPORT_AUTHORITY), which the operator supplies; without one it serves discovery only",
      "interpreter": "node",
      "environment": [
        "APPPORT_AUTHORITY",
        "APPPORT_API_KEY"
      ],
      "authority": {
        "module_env": "APPPORT_AUTHORITY",
        "default_module": "configured/appport-authority.mjs",
        "without": "discovery only: GET /v1/ui answers; every management operation answers 503 AUTHORITY_UNAVAILABLE"
      }
    }
  ],
  "execution_providers": [
    {
      "name": "cloudflare",
      "kind": "cloudflare",
      "protocol": "compute.cloudflare@1",
      "profile": "workers-free",
      "required": false,
      "implementation": "base-compute",
      "credentials": {
        "token_env": "CLOUDFLARE_API_TOKEN",
        "stored": false
      },
      "runs": "short-lived, request-driven WASI modules deployed explicitly as Workers",
      "refuses": [
        "persistent_process",
        "interactive_shell",
        "native_executable",
        "container",
        "process_runtime",
        "filesystem",
        "outbound_network",
        "local_inference"
      ],
      "setup": "compute-configured-cloudflare-setup",
      "example": "providers/cloudflare",
      "documentation": "docs/cloudflare.md"
    }
  ],
  "migrations": [],
  "packages": {
    "@appport/core": "1.0.3",
    "@appport/github": "1.0.2",
    "@appport/runtime": "0.4.6",
    "@appport/server": "1.0.2",
    "@appport/services": "0.4.11",
    "@appport/transport-http": "1.0.2",
    "@appport/transport-inprocess": "1.0.2",
    "@appport/transport-websocket": "1.0.2",
    "@authboundry/core": "1.15.3",
    "@feltdb/core": "0.11.9"
  },
  "contracts": {
    "appport": "AppPort/1",
    "feltdb_protocol": 1,
    "git_source": 1
  },
  "allowed_version_skew": {
    "@feltdb/core": {
      "versions": [
        "0.11.1",
        "0.11.5",
        "0.11.9"
      ],
      "reason": "@authboundry/core 1.15.3 embeds 0.11.5 and its @appport/services 0.3.2 embeds 0.11.1; the stack verifies the published graph against FeltDB protocol 1"
    },
    "@appport/services": {
      "versions": [
        "0.3.2",
        "0.4.6",
        "0.4.11"
      ],
      "reason": "@authboundry/core 1.15.3 embeds 0.3.2; @appport/github 1.0.2 pins 0.4.6; the configured stack itself resolves 0.4.11, the release whose `appport-services` executable runs the standalone management host that serves the AppPort/ui/1 discovery document at GET /v1/ui"
    },
    "@appport/protocol": {
      "versions": [
        "1.0.2",
        "1.0.3"
      ],
      "reason": "@appport/services 0.4.11 declares @appport/protocol ^1.0.3 to build its AppPort/ui/1 contribution with the protocol's own validateUiContribution/filterUiContribution, while @appport/core 1.0.3 and the 1.0.2 @appport/server, @appport/client, @appport/schema and @appport/authorization packages pin 1.0.2"
    }
  }
}
