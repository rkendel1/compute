# /etc/compute/compute.env (mode 0600, owned by root). Never commit it.
# Read only by the controller; never written to control state.
COMPUTE_FELTDB_TOKEN=fdb_live_REPLACE_ME
HETZNER_DNS_TOKEN=REPLACE_WITH_A_HETZNER_CLOUD_API_TOKEN
# Operator credentials are not configured here: the controller issues a
# bootstrap admin token to /var/lib/compute/bootstrap-admin.token on first
# start; create per-operator credentials with it (`compute auth create`)
# and revoke it.
