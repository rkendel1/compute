# systemd unit for the Compute controller on a dedicated host (for example
# a Hetzner server). Compute does not require systemd; this unit only keeps
# the controller running and restarts it after a crash.
#
# Workloads run on the node's supervisor (`--data-plane supervisor`), not in
# the controller: a controller that crashes, is restarted, or is upgraded
# leaves them serving, and the next controller reattaches to them.
[Unit]
Description=Compute controller
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=compute
Group=compute
EnvironmentFile=/etc/compute/compute.env
# Production mode: TLS on the API and an operator credential on every
# request. The certificate and key are reloaded when they change.
ExecStart=/usr/local/bin/compute start --config /etc/compute/compute.toml --state-dir /var/lib/compute --listen 0.0.0.0:8787 --production --tls-cert /etc/compute/tls/api.crt --tls-key /etc/compute/tls/api.key --data-plane supervisor
# SIGTERM detaches the controller: workloads keep running on the
# supervisor, and the next controller reattaches. To stop the workloads
# too, run `compute stop` (SIGINT) before stopping the unit.
KillSignal=SIGTERM
TimeoutStopSec=60
Restart=always
RestartSec=2
# Signal only the controller; the supervisor and the workloads are not
# the controller's to lose on a restart.
KillMode=process
LimitNOFILE=65536
# Ingress binds ports 80 and 443 without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
