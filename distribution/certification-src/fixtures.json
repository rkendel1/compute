{
  "schema_version": 1,
  "appport_runner": "appport/dist/certify.js",
  "runtimes": {
    "wasm": { "entrypoint": "wasm/certify.wasm" },
    "python": { "entrypoint": "python/certify.py" },
    "node": { "entrypoint": "node/certify.js" },
    "bun": { "entrypoint": "bun/certify.js" },
    "deno": { "entrypoint": "deno/certify.js" },
    "ruby": { "entrypoint": "ruby/certify.rb" },
    "php": { "entrypoint": "php/certify.php" },
    "jvm": { "entrypoint": "jvm/certify.jar" },
    "dotnet": {
      "entrypoint": "dotnet/certify.dll",
      "files": ["dotnet/certify.runtimeconfig.json", "dotnet/certify.deps.json"]
    },
    "native": { "entrypoint": "native/certify-native" },
    "shell": { "entrypoint": "shell/certify.sh" }
  }
}
