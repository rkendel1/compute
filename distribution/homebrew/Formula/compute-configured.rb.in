require "json"

class ComputeConfigured < Formula
  desc "Compute with the version-pinned configured ecosystem stack"
  homepage "https://github.com/rkendel1/compute"
  platform = OS.mac? ? "macos-aarch64" : "linux-x86_64"
  checksum = if OS.mac?
    "@MACOS_CONFIGURED_SHA256@"
  else
    "@LINUX_CONFIGURED_SHA256@"
  end
  url "https://github.com/rkendel1/compute/releases/download/v@VERSION@/compute-configured-@VERSION@-#{platform}.tar.gz"
  sha256 checksum
  license "MIT"

  depends_on arch: OS.mac? ? :arm64 : :x86_64
  depends_on "rkendel1/compute/compute"

  # The configured compatibility evidence covers the exact node_modules tree.
  skip_clean "libexec"

  def install
    configured = Pathname.pwd
    configured /= "compute-configured" unless (configured/"stack.json").exist?
    libexec.install configured.children
    # COMPUTE_STACKS selects the configured stack; COMPUTE_CONFIGURED_HOME is the
    # installed distribution root, where the profile and the pinned node_modules
    # (and therefore the services this profile declares it manages) live.
    (bin/"compute-configured").write <<~SH
      #!/bin/sh
      export COMPUTE_STACKS="#{libexec}/stacks${COMPUTE_STACKS:+:$COMPUTE_STACKS}"
      export COMPUTE_CONFIGURED_HOME="#{libexec}"
      exec "#{formula_opt_bin("compute")}/compute" "$@"
    SH
    (bin/"compute-configured-verify").write <<~SH
      #!/bin/sh
      version=$("#{formula_opt_bin("compute")}/compute" --version) || exit
      version=${version#compute }
      COMPUTE_INSTALLED_VERSION="$version" COMPUTE_BIN="#{formula_opt_bin("compute")}/compute" \\
        exec "#{formula_opt_libexec("compute")}/runtimes/node/bin/node" "#{libexec}/verify.mjs"
    SH
    (bin/"compute-configured-setup").write <<~SH
      #!/bin/sh
      "#{bin}/compute-configured-verify" >/dev/null || exit
      status=$("#{formula_opt_libexec("compute")}/runtimes/node/bin/node" -p "require('#{libexec}/stack.json').distribution.certification_status") || exit
      printf '%s\n' "Configured Compute is $status and active through COMPUTE_STACKS."
    SH
    # The Cloudflare execution provider the profile declares as optional. Base
    # Compute carries the provider; this only writes a credential-free pool file
    # for it under COMPUTE_HOME, and never overwrites one that exists, so an
    # upgrade or a second run leaves the user's configuration as it is. The API
    # token is never an argument: the pool file names the variable that holds it.
    (bin/"compute-configured-cloudflare-setup").write <<~SH
      #!/bin/sh
      if [ "$#" -ne 1 ]; then
        echo "usage: compute-configured-cloudflare-setup ACCOUNT_ID" >&2
        echo "  writes ${COMPUTE_HOME:-$HOME/.compute}/configured/cloudflare/compute-pool.toml (see docs/cloudflare.md)" >&2
        exit 2
      fi
      pool="${COMPUTE_HOME:-$HOME/.compute}/configured/cloudflare/compute-pool.toml"
      "#{formula_opt_bin("compute")}/compute" cloudflare init --account-id "$1" --output "$pool" || exit
      "#{formula_opt_bin("compute")}/compute" cloudflare validate --provider cloudflare --offline --pool-config "$pool" || exit
      printf '%s\n' "Use it with: export COMPUTE_POOL_CONFIG='$pool'" \\
        "Then provide the token without writing it down: read -rs CLOUDFLARE_API_TOKEN && export CLOUDFLARE_API_TOKEN" \\
        "Check the account: compute cloudflare validate --provider cloudflare"
    SH
    # The agent: stack-agent (Chip agent orchestration + FX inference, one Rust executable),
    # hosted by Compute as `compute-stack-agent`. It is a configured component, so its launcher
    # lives here and nowhere else: base Compute ships no agent. The agent loop and the model
    # credential stay in this process; every capability it runs (project.read, project.write,
    # pax.test, ...) runs in a Compute session of its own, through `capability-exec`, on the
    # target the operator configures (docs/stack-agent.md).
    #
    # The process starts from an empty environment: only what the agent and its Compute client
    # need is passed through, by name. Nothing else the user's shell holds (cloud keys, tokens
    # for other services) reaches it.
    (bin/"compute-configured-stack-agent").write <<~SH
      #!/bin/sh
      agent="#{libexec}/stack-agent/bin/compute-stack-agent"
      if [ ! -x "$agent" ]; then
        echo "compute-configured-stack-agent: stack-agent is not part of this distribution build ($agent is missing)" >&2
        exit 1
      fi
      # Unset every variable that is not on this list; values are never parsed or rewritten.
      for name in $(env | sed -n 's/^\\([A-Za-z_][A-Za-z0-9_]*\\)=.*/\\1/p'); do
        case "$name" in
          PATH|HOME|TMPDIR|LANG|LC_*|COMPUTE_HOME|COMPUTE_DAEMON|COMPUTE_DAEMON_TOKEN) ;;
          HTTPS_PROXY|HTTP_PROXY|NO_PROXY|https_proxy|http_proxy|no_proxy|SSL_CERT_FILE) ;;
          CHIP_*|OPENAI_API_KEY|ANTHROPIC_API_KEY|COMPUTE_STACK_AGENT_*) ;;
          *) unset "$name" 2>/dev/null ;;
        esac
      done
      export COMPUTE_STACK_AGENT_WORKER="${COMPUTE_STACK_AGENT_WORKER:-$agent}"
      exec "$agent" "$@"
    SH
    # The agent workload entry: `compute-configured-agent [--agent NAME] ARGS...` runs the named
    # agent's launcher. Compute is agent-neutral; this only maps a name to an executable it
    # launches. `stack-agent` is the default and the only agent. An unknown name is an error.
    (bin/"compute-configured-agent").write <<~SH
      #!/bin/sh
      agent=stack-agent
      case "${1:-}" in
        --agent) [ "$#" -ge 2 ] || { echo "compute-configured-agent: --agent needs a name" >&2; exit 2; }
                 agent=$2; shift 2 ;;
        --agent=*) agent=${1#--agent=}; shift ;;
      esac
      case "$agent" in
        stack-agent) exec "#{bin}/compute-configured-stack-agent" "$@" ;;
        *)
          echo "compute-configured-agent: unknown agent '$agent' (available: stack-agent)" >&2
          exit 2 ;;
      esac
    SH
  end

  test do
    assert_equal "compute #{version}\n", shell_output("#{formula_opt_bin("compute")}/compute --version")
    assert_equal version.to_s, JSON.parse((libexec/"stack.json").read).fetch("compute")
    assert_match '"result": "pass"', shell_output("#{bin}/compute-configured-verify")
    expected_status = OS.mac? ? "preview" : "certified"
    assert_match "#{expected_status} and active", shell_output("#{bin}/compute-configured-setup")
    assert_equal 7, JSON.parse(shell_output("#{bin}/compute-configured recipe starters --json")).length
    assert_predicate libexec/"node_modules/@appport/github/package.json", :file?
    assert_predicate libexec/"recipes/starters/dev.json", :file?
    assert_predicate libexec/"stacks/configured/stack.toml", :file?
    # stack-agent is the configured agent. Run it, do not just look for it: with no subcommand it
    # prints its usage and exits 2. The profile names it, and nothing else, as the agent.
    agents = JSON.parse((libexec/"stack.json").read).fetch("agent").fetch("runtimes")
    assert_equal ["stack-agent"], agents.map { |runtime| runtime.fetch("name") }
    assert_predicate libexec/"stack-agent/bin/compute-stack-agent", :executable?
    assert_match "usage: compute-stack-agent",
                 shell_output("#{bin}/compute-configured-stack-agent 2>&1", 2)
    assert_match "usage: compute-stack-agent",
                 shell_output("#{bin}/compute-configured-agent 2>&1", 2)
    refute_predicate libexec/"node_modules/@appport/chip", :exist?
    assert_match "unknown agent", shell_output("#{bin}/compute-configured-agent --agent nope 2>&1", 2)
    # The optional Cloudflare provider: declared by the profile, reported by the
    # installed Compute, set up without a credential, and set up only once.
    cloudflare = JSON.parse((libexec/"stack.json").read)
                     .fetch("execution_providers").find { |provider| provider["kind"] == "cloudflare" }
    refute_nil cloudflare, "the configured profile declares no cloudflare provider"
    assert_equal false, cloudflare.fetch("required")
    profile = JSON.parse(shell_output("#{bin}/compute-configured cloudflare profile #{cloudflare.fetch("profile")} --json"))
    assert_equal false, profile.fetch("capabilities").fetch("persistent_processes")
    ENV.delete("CLOUDFLARE_API_TOKEN")
    assert_match "Credential     missing",
                 shell_output("#{bin}/compute-configured-cloudflare-setup 0123456789abcdef0123456789abcdef")
    pool = testpath/"state/configured/cloudflare/compute-pool.toml"
    assert_predicate pool, :file?
    refute_match(/token\s*=/, pool.read.lines.reject { |line| line.start_with?("#") }.join)
    before = pool.read
    shell_output("#{bin}/compute-configured-cloudflare-setup fedcba9876543210fedcba9876543210")
    assert_equal before, pool.read, "setup must not overwrite an existing pool file"
    capabilities = JSON.parse(shell_output("#{formula_opt_bin("compute")}/compute provider capabilities cloudflare " \
                                           "--json --pool-config #{pool} --capability-cache #{testpath}/cache.json"))
    assert_equal "compute.cloudflare@1", capabilities.fetch("protocol")
    assert_predicate libexec/"providers/cloudflare/hello.wasm", :file?
  end
end
