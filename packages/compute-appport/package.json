{
  "name": "@compute/appport",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AppPort contract and local provider for portable Compute workloads",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@appport/authorization": "1.0.1",
    "@appport/core": "1.0.2",
    "@appport/protocol": "1.0.1",
    "@appport/schema": "1.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
