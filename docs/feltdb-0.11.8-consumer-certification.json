  "remaining_gaps": [
    {
      "gap": "FeltDB 0.11.8's cost per request grows linearly with committed state: at 4,000 committed operations /v1/state/version takes ~42 ms and an index probe returning nothing ~81 ms (FeltDB reports ~32 ms of execution), while /health stays ~0.6 ms",
      "status": "MEASURED",
      "attribution": "FeltDB (inside its request handling; the exact cause is not isolated)",
      "evidence": "feltdb-request-cost.json"
    },
    {
      "gap": "Controller start with state is slower: 22.6 s vs 14.3 s before, at this dataset",
      "status": "MEASURED",
      "attribution": "Partly attributed: the start now runs the identity-backfill probe (21 FeltDB requests, each scanning its collection for records without record_id) and builds the desired snapshot by identity probes (~68 FeltDB requests), each paying FeltDB's per-request cost; the split between them was not measured",
      "evidence": "feltdb-consumer-benchmark.json, feltdb-consumer-benchmark-before.json"
    },
    {
      "gap": "Execution lookup (135 vs 102 ms) and release lookup (270 vs 195 ms) are slower, with the same number of FeltDB requests as before",
      "status": "UNKNOWN",
      "attribution": "Not isolated. Both are FeltDB-request bound; the state size at the moment of measurement and the model's added indexes differ between the runs"
    },
    {
      "gap": "FeltDB 0.11.8 backup verify rejects an online backup of application state ('snapshot contains an invalid state row'); compute control-plane upgrade therefore stops before changing anything when given --backup, and --backup-archive (an offline FeltDB backup) is the working path",
      "status": "FAIL",
      "attribution": "FeltDB 0.11.8 (export_snapshot / install_snapshot)"
    },
    {
      "gap": "A restored FeltDB archive names its sidecars applications.json and platform.json; a server on files/state.log reads state.applications.json and state.platform.json, so they must be renamed before serving",
      "status": "MEASURED",
      "attribution": "FeltDB 0.11.8"
    },
    {
      "gap": "The 0.11.7 and 0.11.8 servers report the same version (0.2.0) and capability fingerprint; the server release cannot be verified from the wire",
      "status": "UNKNOWN",
      "attribution": "FeltDB"
    },
    {
      "gap": "FeltDB 0.11.8's planner uses no ordered index: the newest event (start, recovery) and unscoped operator listings scan server-side",
      "status": "SUPPORTED",
      "attribution": "FeltDB planner; bounded by what FeltDB returns (limit), not by what it examines"
    },
    {
      "gap": "Placement never re-discovers a provider's capabilities after their cache entry expires, so a long-running controller eventually cannot place new workloads (reproduced on Compute eac2be8 too)",
      "status": "FAIL",
      "attribution": "Compute placement (pre-existing; out of this change's scope, reported)"
    },
    {
      "gap": "Managed FeltDB over a network; half-open partitions; more than one controller per control plane",
      "status": "NOT_RUN"
    },
    {
      "gap": "Rollback of a Compute model upgrade: FeltDB revisions are immutable and the previous revision can be promoted again, but Compute has no command for it and it was not exercised",
      "status": "NOT_RUN"
    }
  ],
